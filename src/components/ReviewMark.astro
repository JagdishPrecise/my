---
/** The signature element: a pen-ink check in a box with a mono label.
 *  Used only where a human review step genuinely exists. */
interface Props {
  label?: string;
}
const { label = 'Human review' } = Astro.props;
---

<span class="mark">
  <svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">
    <rect
      x="1"
      y="1"
      width="14"
      height="14"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
    ></rect>
    <path
      d="M4 8.5l3 3 5-6.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
  {label}
</span>

<style>
  .mark {
    display: inline-flex;
    align-items: center;
    gap: var(--s1);
    color: var(--pen);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  svg {
    flex: none;
  }
</style>
