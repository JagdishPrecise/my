---
import { method } from '../lib/site';
interface Props {
  columns?: 1 | 2;
}
const { columns = 2 } = Astro.props;
---

<ol class:list={['steps', `cols-${columns}`]}>
  {
    method.map(([name, text]) => (
      <li>
        <div>
          <b>{name}</b>
          <p>{text}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s3) var(--s5);
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps.cols-1 {
    grid-template-columns: 1fr;
  }
  li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 12px;
    counter-increment: step;
  }
  li::before {
    content: counter(step);
    font-family: var(--serif);
    font-size: var(--h);
    line-height: 1;
    color: var(--pen);
  }
  b {
    display: block;
    margin-bottom: 4px;
  }
  p {
    font-size: var(--small);
    color: var(--graphite);
  }
  @media (max-width: 899px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
