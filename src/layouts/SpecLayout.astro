---
/** The specification grid: a margin column for metadata (cols 1-3) and a content column (cols 5-12).
 *  Stacks to one column below 900px. */
interface Props {
  id?: string;
  label?: string;
  tight?: boolean;
  sticky?: boolean;
  class?: string;
  noBorder?: boolean;
}
const { id, label, tight = false, sticky = false, class: cls = '', noBorder = false } = Astro.props;
---

<section
  id={id}
  class:list={['spec', { tight, 'no-border': noBorder }, cls]}
  aria-labelledby={label ? `${id}-h` : undefined}
>
  <div class:list={['margin', { sticky }]}>
    {label && (
      <h2 id={`${id}-h`} class="mono">
        {label}
      </h2>
    )}
    <slot name="margin" />
  </div>
  <div class="content">
    <slot />
  </div>
  <slot name="bleed" />
</section>

<style>
  .spec {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--s3);
    padding-block: var(--section);
    border-bottom: 1px solid var(--rule);
  }
  .spec.tight {
    padding-block: var(--s6);
  }
  .spec.no-border {
    border-bottom: 0;
  }
  .margin {
    grid-column: 1 / 4;
    min-width: 0;
    display: grid;
    gap: var(--s3);
    align-content: start;
  }
  .margin.sticky {
    position: sticky;
    top: var(--s3);
    align-self: start;
  }
  .content {
    grid-column: 5 / 13;
    min-width: 0;
  }
  @media (max-width: 899px) {
    .spec {
      grid-template-columns: 1fr;
      gap: var(--s4);
    }
    .margin,
    .content {
      grid-column: 1 / -1;
    }
    .margin.sticky {
      position: static;
    }
  }
</style>
